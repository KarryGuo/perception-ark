# ===== PerceptionArk 后端环境变量配置 =====
# 复制本文件为 .env 并填写真实值

# 服务端口
PORT=3001

# ===== 阿里千问 Qwen API (多模型分工) =====
# 申请地址：https://dashscope.console.aliyun.com/
# 主密钥(所有模型共用同一密钥)
QWEN_API_KEY=your_qwen_api_key_here
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# --- 多模型分工(各Agent专用模型,失败自动降级到QWEN_MODEL兜底) ---
# 默认兜底模型: 全模态,任何专用模型失败时自动降级使用
QWEN_MODEL=qwen3.5-omni-flash
# 视觉专用(A01场景感知/A03安全预警): 纯视觉,比Omni快,成本低
QWEN_MODEL_VL=qwen-vl-plus
# OCR专用(A04文字识别): 默认同VL,读药盒小字/远处招牌时可升级为qwen-vl-max提升精度
QWEN_MODEL_OCR=qwen-vl-plus
# 文本专用(A02导航意图/选择POI意图识别): 最快最省,纯文本
QWEN_MODEL_TURBO=qwen-turbo
# 全模态专用(A04人脸识别:需视觉+语音协同)
QWEN_MODEL_OMNI=qwen-omni-turbo

# ===== 高德地图 API (导航Agent使用) =====
# 申请地址：https://lbs.amap.com/
# 后端REST API密钥 (导航/POI搜索/逆地理编码/天气)
AMAP_API_KEY=your_amap_api_key_here
# 前端JS API Key (地图渲染,与后端密钥不同)
VITE_AMAP_JS_KEY=your_amap_js_key_here
# 前端JS API 安全密钥
VITE_AMAP_SECURITY_CODE=your_amap_security_code_here

# ===== JWT密钥 (建议填写,保证token安全) =====
JWT_SECRET=your_jwt_secret_here

# ===== 短信服务 (可选,用于家属邀请注册/SOS通知) =====
# SMS_PROVIDER: none=仅记录日志(默认,开发模式) / aliyun=阿里云短信 / tencent=腾讯云短信
SMS_PROVIDER=none
# 阿里云短信配置 (SMS_PROVIDER=aliyun 时需填写,并安装 @alicloud/dysmsapi20170525)
# ALIYUN_SMS_ACCESS_KEY_ID=your_access_key_id
# ALIYUN_SMS_ACCESS_KEY_SECRET=your_access_key_secret
# ALIYUN_SMS_SIGN_NAME=感知方舟
# ALIYUN_SMS_INVITE_TEMPLATE_CODE=SMS_xxxxx

# ===== 是否启用模拟模式 (无API Key时设为true) =====
MOCK_MODE=true