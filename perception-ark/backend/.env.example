# ===== PerceptionArk 后端环境变量配置 =====
# 复制本文件为 .env 并填写真实值

# 服务端口
PORT=3001

# ===== 阿里千问 Qwen API (全模态大模型) =====
# 申请地址：https://dashscope.console.aliyun.com/
# 模型: qwen3.5-omni-flash (视觉+文本+音频+视频)
QWEN_API_KEY=your_qwen_api_key_here
QWEN_MODEL=qwen3.5-omni-flash
# API 端点 (DashScope OpenAI兼容模式)
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 高德地图 API (导航Agent使用) =====
# 申请地址：https://lbs.amap.com/
# 后端REST API密钥 (导航/POI搜索/逆地理编码/天气)
AMAP_API_KEY=your_amap_api_key_here
# 前端JS API Key (地图渲染,与后端密钥不同)
VITE_AMAP_JS_KEY=your_amap_js_key_here
# 前端JS API 安全密钥
VITE_AMAP_SECURITY_CODE=your_amap_security_code_here

# ===== JWT密钥 (建议填写,保证token安全) =====
JWT_SECRET=your_jwt_secret_here

# ===== 家属端 SOS 短信通知 (可选,留空则只记录日志) =====
# 默认不发送真实短信,SOS事件只记录到家属端
SMS_PROVIDER=none

# ===== 是否启用模拟模式 (无API Key时设为true) =====
MOCK_MODE=true
