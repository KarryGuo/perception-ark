# ===== PerceptionArk 后端环境变量配置 =====
# 复制本文件为 .env 并填写真实值

# 服务端口
PORT=3001

# ===== 火山引擎方舟 (ARK) / 豆包大模型 API =====
# 申请地址：https://console.volcengine.com/ark
ARK_API_KEY=your_ark_api_key_here
# 视觉理解模型ID (doubao-vision-pro / doubao-1.5-vision-pro)
ARK_VISION_MODEL=doubao-1.5-vision-pro-32k
# 文本对话模型ID (doubao-pro / doubao-1.5-pro)
ARK_TEXT_MODEL=doubao-1.5-pro-32k
# API 端点
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3

# ===== 高德地图 API (导航Agent使用) =====
# 申请地址：https://lbs.amap.com/
AMAP_API_KEY=your_amap_api_key_here

# ===== 家属端 SOS 短信通知 (可选,留空则只记录日志) =====
# 默认不发送真实短信,SOS事件只记录到家属端
SMS_PROVIDER=none

# ===== 是否启用模拟模式 (无API Key时设为true) =====
MOCK_MODE=true
